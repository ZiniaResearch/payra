# Local development settings for the PostgreSQL service in compose.yaml.
DATABASE_URL=postgresql://payra:payra_dev@127.0.0.1:5432/payra?sslmode=disable
BIND_ADDR=127.0.0.1:8000
UI_ORIGIN=url-to-your-frontend
# Public API origin; must match the origin used by VITE_API_URL.
API_ORIGIN=http://localhost:8000
# Public read URL for the Garage preset bucket (use HTTPS in production).
MEDIA_BASE_URL=http://payra-presets.web.garage.localhost:3902
# Optional: uncomment all five settings to enable avatar uploads and cleanup.
# AVATAR_S3_ENDPOINT=http://127.0.0.1:3900
# AVATAR_S3_BUCKET=payra-avatars
# AVATAR_S3_REGION=garage  # Optional; defaults to garage.
# AVATAR_S3_ACCESS_KEY_ID=your-avatars-only-access-key-id
# AVATAR_S3_SECRET_ACCESS_KEY=your-avatars-only-secret
# AVATAR_PUBLIC_BASE_URL=http://payra-avatars.web.garage.localhost:3902
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
ACCESS_JWT_SECRET=paste-first-result
REFRESH_JWT_SECRET=paste-second-result
